{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python .claude/hooks/session_start.py",
            "timeout": 20,
            "statusMessage": "FormCoach: loading docs/STATUS.md"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python .claude/hooks/data_guard.py",
            "timeout": 15,
            "statusMessage": "FormCoach: data-hygiene guard"
          }
        ]
      }
    ]
  }
}
